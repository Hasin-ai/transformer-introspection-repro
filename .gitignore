# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# Secrets and local overrides
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
config.local.yaml

# ---------------------------------------------------------------------------
# Model weights and caches
#
# The model downloads to ~/.cache/huggingface, outside the repo. These patterns
# catch checkpoints written into the working tree by accident — a stray 1 GB
# .safetensors in a commit is very hard to get back out.
# ---------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
.cache/
wandb/
logs/

# ---------------------------------------------------------------------------
# Experiment output
#
# Everything under results/ is regenerated by `python run_all.py`, so the bulky
# per-run artefacts stay out of git while the directory structure stays in
# (via the .gitkeep files, which the last rule re-includes).
#
# Deliberately NOT ignored, because they are the run worth pointing at:
#   results/REPORT.md        the verdict
#   results/run_record.json  config + environment that produced it
# ---------------------------------------------------------------------------
results/raw/*
results/processed/*
results/figures/*
!results/**/.gitkeep
