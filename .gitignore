.DS_Store

# Results are regenerated by `python run_all.py`. Keep the directories, not the
# contents — except REPORT.md, which is worth committing when you have a run
# you want to point at.
results/raw/*
results/processed/*
results/figures/*
!results/**/.gitkeep
